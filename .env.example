# Required: the only key Expo exposes to the client bundle (EXPO_PUBLIC_*).
EXPO_PUBLIC_BACKEND_BASE_URL=http://192.168.x.x:5000
# Optional, kept for backwards compatibility. Ignored at runtime when
# EXPO_PUBLIC_BACKEND_BASE_URL is set.
BACKEND_BASE_URL=http://localhost:5000

EXPO_PUBLIC_APPWRITE_PROJECT_ID=xxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_APPWRITE_PROJECT_NAME="SHEild"
EXPO_PUBLIC_APPWRITE_ENDPOINT=xxxxxxxxxxxxxxxxxxxxx

# Google OAuth "Web application" client ID (NOT the Android client ID).
# Must also be listed under Appwrite Console -> Auth -> Social providers -> Google
# -> Native sign-in -> Web client IDs
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxxxxxxxxxx.apps.googleusercontent.com
# Optional: iOS OAuth client ID (reversed client ID). Leave empty to fall back to
# the browser flow on iOS.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
